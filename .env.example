# =============================================================================
# VARIABLES DE ENTORNO PÚBLICAS PARA SUPABASE (Punto 15 y 16)
# =============================================================================
# Copiá este archivo como ".env" en la raíz del proyecto y completá tus datos
# desde el panel de Supabase -> Project Settings -> API.
# Podés usar VITE_SUPABASE_PUBLISHABLE_KEY o VITE_SUPABASE_ANON_KEY.
# IMPORTANTE (Seguridad): NUNCA pongas la clave "service_role" ni contraseñas
# de base de datos aquí. Solo se debe usar la clave pública (publishable/anon).
# =============================================================================

VITE_SUPABASE_URL=https://tu-proyecto-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica_aqui
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon_aqui
